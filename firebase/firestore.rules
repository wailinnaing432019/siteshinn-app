rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function accountPath(accountId) {
      return /databases/$(database)/documents/accounts/$(accountId);
    }

    function isAccountMember(accountId) {
      return isSignedIn()
        && exists(accountPath(accountId))
        && (
          get(accountPath(accountId)).data.owner_id == request.auth.uid ||
          request.auth.uid in get(accountPath(accountId)).data.member_user_ids
        );
    }

    function isAccountMemberAfter(accountId) {
      return isSignedIn()
        && existsAfter(accountPath(accountId))
        && (
          getAfter(accountPath(accountId)).data.owner_id == request.auth.uid ||
          request.auth.uid in getAfter(accountPath(accountId)).data.member_user_ids
        );
    }

    function isSelfJoiningAccount() {
      return isSignedIn()
        && resource.data.account_type == 'group'
        && resource.data.invite_code != null
        && exists(/databases/$(database)/documents/invites/$(resource.data.invite_code))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['member_user_ids'])
        && request.resource.data.member_user_ids.hasAll(resource.data.member_user_ids)
        && request.resource.data.member_user_ids.size() <= resource.data.member_user_ids.size() + 1
        && request.auth.uid in request.resource.data.member_user_ids;
    }

    match /accounts/{accountId} {
      allow read: if isSignedIn() && (
        resource.data.owner_id == request.auth.uid ||
        request.auth.uid in resource.data.member_user_ids
      );
      allow create: if isSignedIn()
        && request.resource.data.owner_id == request.auth.uid
        && request.auth.uid in request.resource.data.member_user_ids;
      allow update: if isSignedIn() && (
        resource.data.owner_id == request.auth.uid ||
        request.auth.uid in resource.data.member_user_ids ||
        isSelfJoiningAccount()
      );
      allow delete: if isSignedIn() && resource.data.owner_id == request.auth.uid;

      match /members/{memberId} {
        allow read, delete: if isAccountMember(accountId);
        allow create, update: if isAccountMember(accountId) || isAccountMemberAfter(accountId);
      }

      match /cycles/{cycleId} {
        allow read, delete: if isAccountMember(accountId);
        allow create, update: if isAccountMember(accountId) || isAccountMemberAfter(accountId);
      }

      match /expenses/{expenseId} {
        allow read, delete: if isAccountMember(accountId);
        allow create, update: if isAccountMember(accountId) || isAccountMemberAfter(accountId);
      }

      match /transfers/{transferId} {
        allow read, delete: if isAccountMember(accountId);
        allow create, update: if isAccountMember(accountId) || isAccountMemberAfter(accountId);
      }
    }

    match /invites/{code} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSignedIn() && request.resource.data.owner_id == request.auth.uid;
      allow update: if isAccountMember(resource.data.account_id);
      allow delete: if isSignedIn() && resource.data.owner_id == request.auth.uid;
    }

    // Public read-only app version metadata for Play Store-free in-app updates
    match /app_config/{docId} {
      allow get: if true;
      allow list: if false;
      allow write: if false;
    }
  }
}
